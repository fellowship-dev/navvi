{
  "heuristic": "url-variant-beats-master",
  "encounter": "StoreA, 2026-09-22. The URL asked for variant 883052 while the page declared master SKU 8820237; the caller asked for the variant.",
  "cases": [
    {
      "name": "the URL names the variant the caller asked for",
      "observation": {
        "url": "https://store-a.example/products/paracetamol-500-mg-20-comprimidos/883052",
        "declaredSku": "8820237"
      },
      "expect": {
        "fires": true,
        "pick": "883052",
        "becauseIncludes": "the URL asks for 883052"
      }
    },
    {
      "name": "the URL names nothing the page does not already declare",
      "observation": {
        "url": "https://store-a.example/products/ibuprofeno/8820237",
        "declaredSku": "8820237"
      },
      "expect": {
        "fires": false,
        "becauseIncludes": "no identifier other than"
      }
    },
    {
      "name": "a slug with no identifier leaves the declared sku alone",
      "observation": {
        "url": "https://store-a.example/products/ibuprofeno-400-mg",
        "declaredSku": "8820237"
      },
      "expect": {
        "fires": false,
        "becauseIncludes": "no identifier other than"
      }
    }
  ]
}
